# frontend/.env.example — copia como frontend/.env
# Firebase Console > Configuración del proyecto > Tus apps > App web > Configuración del SDK
VITE_FIREBASE_API_KEY=AQUI_VA_TU_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=tu-proyecto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=tu-proyecto
VITE_FIREBASE_APP_ID=1:000000000000:web:xxxxxxxxxxxx

# URL del backend en Render (vacío en desarrollo: Vite redirige /api a localhost:3001)
VITE_API_URL=

# true = sin login (solo desarrollo, debe coincidir con AUTH_DISABLED=true del backend)
VITE_AUTH_DISABLED=false
