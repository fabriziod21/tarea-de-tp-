# ============================================
# BACKEND — backend/.env.example
# Copia este archivo como backend/.env y completa los valores.
# backend/.env NUNCA se sube a GitHub (está en .gitignore).
# ============================================

# Servidor
PORT=3001
NODE_ENV=development
# Origen permitido del frontend (separa varios con coma)
CORS_ORIGIN=http://localhost:5173

# Claude / Anthropic
# api  = Claude API con ANTHROPIC_API_KEY (necesario para desplegar en Render)
# code = tu Claude Code con la sesión de tu cuenta, sin API key (solo en tu PC, para la demo)
CLAUDE_PROVIDER=api
CLAUDE_CODE_MODEL=sonnet
# CLAUDE_CODE_PATH=   (ruta a claude.exe si el backend no lo encuentra solo)
ANTHROPIC_API_KEY=sk-ant-AQUI_VA_TU_CLAVE
# La guía pide Sonnet; claude-sonnet-5-5 es el Sonnet actual (claude-sonnet-4-5 ya es antiguo)
CLAUDE_MODEL=claude-sonnet-5-5
# Esfuerzo de razonamiento: low | medium | high
CLAUDE_EFFORT=medium
# "default" = si el modelo rechaza la consulta, la API reintenta sola con otro modelo. "off" para desactivar
CLAUDE_FALLBACKS=default

# Firebase Admin SDK (Firebase Console > Configuración > Cuentas de servicio > Generar nueva clave privada)
FIREBASE_PROJECT_ID=AQUI_VA_TU_PROJECT_ID
FIREBASE_CLIENT_EMAIL=AQUI_VA_TU_CLIENT_EMAIL
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nAQUI_VA_TU_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"
# Solo para desarrollo local SIN Firebase. Se ignora si NODE_ENV=production.
AUTH_DISABLED=false

# PostgreSQL (Neon) — SOLO USUARIO DE LECTURA
DB_HOST=AQUI_VA_TU_HOST_NEON
DB_PORT=5432
DB_NAME=AQUI_VA_TU_NOMBRE_BD
DB_USER=chatbot_reader
DB_PASSWORD=AQUI_VA_TU_PASSWORD
DB_SSL=true

# Solo para scripts (npm run db:apply / RAG con pgvector). El chatbot NUNCA usa esta conexión.
DB_ADMIN_URL=postgresql://USUARIO_ADMIN:PASSWORD@HOST/BD?sslmode=require

# MCP Server
MCP_SERVER_NAME=postgres-mcp-server

# RENIEC / Json.pe
JSONPE_API_TOKEN=AQUI_VA_TU_TOKEN_JSONPE
JSONPE_BASE_URL=https://api.json.pe
# true = datos simulados (no gasta créditos). Pon false para usar la API real.
RENIEC_MOCK=true

# RAG: local (índice JSON, sin servidores) | chroma (ChromaDB) | pgvector (Neon)
# La guía usa chroma en desarrollo (npm run chroma:setup una vez; npm run dev lo enciende)
# y pgvector en producción. Si el elegido falla, se usa el índice local como respaldo.
RAG_PROVIDER=local
CHROMA_URL=http://127.0.0.1:8000
